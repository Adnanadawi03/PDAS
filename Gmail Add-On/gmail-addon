function scanEmail(e) {
  const msgId   = e.parameters.msgId;
  const from    = e.parameters.from || '';
  const subject = e.parameters.subject || '';
  const props   = PropertiesService.getUserProperties();
  const userId  = props.getProperty('pdas_user_id');
  if (!userId) return buildMsg('⚠️ Please sign in to PDAS first.');

  const accessToken = refreshTokenIfNeeded(props) || props.getProperty('pdas_access_token');
  try {
    const msg    = GmailApp.getMessageById(msgId);
    const result = scanSingleMessage(msg, accessToken, userId);
    return buildResultCard(result.verdict, result.score, from, subject);
  } catch(err) {
    return buildMsg('❌ Scan error: ' + err.message);
  }
}

function enableAutoScan(e) {
  try {
    setupAutoScanTrigger();
    return buildMsg('✅ Auto-scan enabled!\n\nEmails will now be scanned every 5 minutes automatically. Results appear in your PDAS dashboard.');
  } catch(err) {
    return buildMsg('❌ Could not enable auto-scan: ' + err.message + '\n\nTry: Extensions → Apps Script → Run → setupAutoScanTrigger');
  }
}

function manualScanAll(e) {
  try {
    autoScanNewEmails();
    const props = PropertiesService.getUserProperties();
    props.setProperty('pdas_last_scan', Date.now().toString());
    return buildMsg('✅ Scan complete!\n\nAll recent emails have been scanned. Check your PDAS dashboard for results.');
  } catch(err) {
    return buildMsg('❌ Error: ' + err.message);
  }
}

// ────────────────────────────────────────────
// HELPERS
// ────────────────────────────────────────────

function safeScanUrl(url) {
  try {
    const res = UrlFetchApp.fetch(API_BASE + '/scan/url', {
      method: 'post', contentType: 'application/json',
      payload: JSON.stringify({ url }),
      muteHttpExceptions: true, followRedirects: true
    });
    if (res.getResponseCode() === 200) return JSON.parse(res.getContentText());
  } catch(e) {}
  return null;
}

function refreshTokenIfNeeded(props) {
  const rt = props.getProperty('pdas_refresh_token');
  if (!rt) return null;
  try {
    const res = UrlFetchApp.fetch(SUPABASE_URL + '/auth/v1/token?grant_type=refresh_token', {
      method: 'post',
      headers: { apikey: SUPABASE_KEY, 'Content-Type': 'application/json' },
      payload: JSON.stringify({ refresh_token: rt }),
      muteHttpExceptions: true
    });
    const d = JSON.parse(res.getContentText());
    if (d.access_token) {
      props.setProperty('pdas_access_token', d.access_token);
      if (d.refresh_token) props.setProperty('pdas_refresh_token', d.refresh_token);
      return d.access_token;
    }
  } catch(e) {}
  return null;
}

function saveToSupabase(accessToken, userId, from, subject, verdict, score, results, urls) {
  try {
    const pRes   = UrlFetchApp.fetch(SUPABASE_URL + '/rest/v1/profiles?id=eq.' + userId + '&select=company_id', {
      headers: { apikey: SUPABASE_KEY, Authorization: 'Bearer ' + accessToken },
      muteHttpExceptions: true
    });
    const profiles   = JSON.parse(pRes.getContentText());
    const company_id = profiles[0]?.company_id || null;

    UrlFetchApp.fetch(SUPABASE_URL + '/rest/v1/scan_logs', {
      method: 'post',
      headers: { apikey: SUPABASE_KEY, Authorization: 'Bearer ' + accessToken, 'Content-Type': 'application/json', Prefer: 'return=minimal' },
      payload: JSON.stringify({ user_id: userId, company_id, type: 'email', target: from + ' — ' + subject, verdict, score, signals: { from, subject, urls, results } }),
      muteHttpExceptions: true
    });
  } catch(e) { Logger.log('[PDAS] Save error: ' + e.message); }
}

function buildResultCard(verdict, score, from, subject) {
  const icons  = { allow:'✅', warn:'⚠️', block:'🚫' };
  const labels = { allow:'Safe Email', warn:'Suspicious', block:'Phishing!' };
  const risk   = score >= 80 ? 'HIGH RISK' : score >= 50 ? 'MEDIUM RISK' : 'LOW RISK';
  const card = CardService.newCardBuilder().setName('Result')
    .setHeader(CardService.newCardHeader()
      .setTitle(icons[verdict] + ' ' + labels[verdict])
      .setSubtitle('Score: ' + parseFloat(score).toFixed(1) + '/100 · ' + risk)
      .setImageUrl(WEBSITE_URL + '/icons/icon128.png')
      .setImageStyle(CardService.ImageStyle.CIRCLE)
    );
  card.addSection(CardService.newCardSection()
    .addWidget(CardService.newTextParagraph().setText('<b>From:</b> ' + from + '<br><b>Subject:</b> ' + subject.slice(0,70)))
    .addWidget(CardService.newTextParagraph().setText('✓ Result saved to your PDAS dashboard'))
    .addWidget(CardService.newTextButton().setText('📊 View Dashboard').setOpenLink(CardService.newOpenLink().setUrl(WEBSITE_URL + '/email-scans.html')))
  );
  if (verdict === 'block') {
    card.addSection(CardService.newCardSection().addWidget(CardService.newTextParagraph().setText('⛔ DO NOT click links or open attachments!')));
  }
  return card.build();
}

function buildMsg(msg) {
  return CardService.newCardBuilder().setName('PDAS')
    .setHeader(CardService.newCardHeader().setTitle('PDAS Email Guard').setImageUrl(WEBSITE_URL + '/icons/icon128.png').setImageStyle(CardService.ImageStyle.CIRCLE))
    .addSection(CardService.newCardSection()
      .addWidget(CardService.newTextParagraph().setText(msg))
      .addWidget(CardService.newTextButton().setText('📊 Dashboard').setOpenLink(CardService.newOpenLink().setUrl(WEBSITE_URL + '/dashboard.html')))
    ).build();
}
