/**
 * Call this ONCE to set up auto-scanning every 5 minutes.
 * Run from Apps Script editor: click Run → setupAutoScanTrigger
 */
function setupAutoScanTrigger() {
  // Remove existing triggers
  ScriptApp.getProjectTriggers().forEach(t => {
    if (t.getHandlerFunction() === 'autoScanNewEmails') {
      ScriptApp.deleteTrigger(t);
    }
  });
  // Create new trigger — every 5 minutes
  ScriptApp.newTrigger('autoScanNewEmails')
    .timeBased()
    .everyMinutes(5)
    .create();
  Logger.log('✅ Auto-scan trigger set up! Emails will be scanned every 5 minutes.');
}

/**
 * Auto-scan new emails from ALL labels (inbox, promotions, etc.)
 * Triggered every 5 minutes automatically.
 */
function autoScanNewEmails() {
  const props       = PropertiesService.getUserProperties();
  const accessToken = refreshTokenIfNeeded(props) || props.getProperty('pdas_access_token');
  const userId      = props.getProperty('pdas_user_id');

  if (!userId || !accessToken) {
    Logger.log('[PDAS] Not signed in — skipping auto-scan');
    return;
  }

  // Get last scan timestamp
  const lastScan = parseInt(props.getProperty('pdas_last_scan') || '0');
  const since    = new Date(lastScan || (Date.now() - 10 * 60 * 1000)); // last 10 min on first run

  Logger.log('[PDAS] Auto-scanning emails since: ' + since.toISOString());

  // Search ALL mail (not just inbox) for recent emails
  const query    = 'after:' + Math.floor(since.getTime() / 1000);
  const threads  = GmailApp.search(query, 0, 20); // max 20 threads per run
  let scannedCount = 0;

  for (const thread of threads) {
    const messages = thread.getMessages();
    for (const msg of messages) {
      if (msg.getDate().getTime() <= lastScan) continue;
      try {
        const result = scanSingleMessage(msg, accessToken, userId);
        if (result) {
          scannedCount++;
          Logger.log('[PDAS] Scanned: ' + msg.getSubject() + ' → ' + result.verdict + ' (' + result.score + ')');
          // Mark high risk emails
          if (result.verdict === 'block') {
            try { thread.addLabel(getOrCreateLabel('⛔ PDAS Phishing')); } catch(e) {}
          } else if (result.verdict === 'warn') {
            try { thread.addLabel(getOrCreateLabel('⚠️ PDAS Suspicious')); } catch(e) {}
          }
        }
      } catch(e) {
        Logger.log('[PDAS] Error scanning message: ' + e.message);
      }
    }
  }

  // Update last scan time
  props.setProperty('pdas_last_scan', Date.now().toString());
  Logger.log('[PDAS] Auto-scan complete. Scanned ' + scannedCount + ' new messages.');
}

function getOrCreateLabel(name) {
  return GmailApp.getUserLabelByName(name) || GmailApp.createLabel(name);
}

function scanSingleMessage(msg, accessToken, userId) {
  const from    = msg.getFrom() || '';
  const subject = msg.getSubject() || '';
  const body    = msg.getPlainBody() || '';

  const urlRegex = /https?:\/\/[^\s"'<>]+/g;
  const urls     = [...new Set((body.match(urlRegex) || []))].slice(0, 5);

  let maxScore   = 0;
  let maxVerdict = 'allow';
  const results  = [];

  // Scan sender domain
  const senderMatch = from.match(/@([^>]+)/);
  if (senderMatch) {
    const domain = 'http://' + senderMatch[1].trim().replace(/[\s>]/g,'');
    const r = safeScanUrl(domain);
    if (r) {
      const score = parseFloat(r.score || 0);
      if (score > maxScore) { maxScore = score; maxVerdict = r.verdict || 'allow'; }
      results.push({ item: 'Sender', target: from, verdict: r.verdict, score });
    }
  }

  // Scan URLs
  for (const url of urls.slice(0, 3)) {
    const r = safeScanUrl(url);
    if (r) {
      const score = parseFloat(r.score || 0);
      if (score > maxScore) { maxScore = score; maxVerdict = r.verdict || 'allow'; }
      results.push({ item: 'URL', target: url.slice(0,60), verdict: r.verdict, score });
    }
  }

  // Save to Supabase
  saveToSupabase(accessToken, userId, from, subject, maxVerdict, maxScore, results, urls);

  return { verdict: maxVerdict, score: maxScore };
}

