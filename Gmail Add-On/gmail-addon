function signInPDAS(e) {
  const email    = e.formInput.email;
  const password = e.formInput.password;
  if (!email || !password) return buildMsg('❌ Please enter email and password.');
  try {
    const res  = UrlFetchApp.fetch(SUPABASE_URL + '/auth/v1/token?grant_type=password', {
      method: 'post',
      headers: { apikey: SUPABASE_KEY, 'Content-Type': 'application/json' },
      payload: JSON.stringify({ email, password }),
      muteHttpExceptions: true
    });
    const data = JSON.parse(res.getContentText());
    if (!data.access_token) return buildMsg('❌ Login failed: ' + (data.error_description || data.error || 'Invalid credentials'));

    const props = PropertiesService.getUserProperties();
    props.setProperty('pdas_access_token', data.access_token);
    props.setProperty('pdas_refresh_token', data.refresh_token || '');
    props.setProperty('pdas_user_id',       data.user.id);
    props.setProperty('pdas_user_name',     data.user.user_metadata?.full_name || email.split('@')[0]);
    props.setProperty('pdas_user_email',    email);

    // Auto-setup trigger on login
    let triggerOk = false;
    try { setupAutoScanTrigger(); triggerOk = true; } catch(err) {
      Logger.log('[PDAS] Trigger setup failed: ' + err.message);
    }

    const statusMsg = triggerOk
      ? '✅ Signed in as ' + email + '!\n\n🔄 Auto-scan is now ACTIVE — emails will be scanned every 5 minutes automatically and results saved to your PDAS dashboard.'
      : '✅ Signed in as ' + email + '!\n\n⚠️ Auto-scan needs one-time setup:\n1. Open Extensions → Apps Script\n2. Click Run → setupAutoScanTrigger\n3. Approve permissions when prompted\n\nOr click "⚡ Scan All Recent Emails Now" to scan manually.';
    return buildMsg(statusMsg);
  } catch(err) {
    return buildMsg('❌ Error: ' + err.message);
  }
}

function signOut(e) {
  // Remove triggers
  ScriptApp.getProjectTriggers().forEach(t => {
    if (t.getHandlerFunction() === 'autoScanNewEmails') ScriptApp.deleteTrigger(t);
  });
  PropertiesService.getUserProperties().deleteAllProperties();
  return buildHomepage(e);
}

